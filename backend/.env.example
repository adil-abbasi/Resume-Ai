# AI Resume Assistant Environment Config
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# LinkedIn OAuth 2.0 Credentials (Sign In with LinkedIn using OpenID Connect)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:5173/api/auth/linkedin/callback

# Dynamic Job Search Provider Configuration (adzuna, jooble, or open_web)
JOB_SEARCH_PROVIDER=adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
JOOBLE_API_KEY=
